# ---------------------------------------------------------------------------
# FlexyVotes configuration. Copy to .env and fill in. Never commit .env.
# Full reference: docs/OPERATIONS.md
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=vote.example.com
CSRF_TRUSTED_ORIGINS=https://vote.example.com
SITE_URL=https://vote.example.com
PLATFORM_NAME=FlexyVotes
ADMIN_URL=admin/
PORT=8000
ENVIRONMENT=production
TIME_ZONE=Africa/Accra
DEFAULT_CURRENCY=GHS

# --- Database / cache / jobs -----------------------------------------------
# DATABASE_URL=postgres://user:password@host:5432/flexyvotes
DATABASE_SSL_REQUIRE=True
# DATABASE_REPLICA_URL=postgres://user:password@replica-host:5432/flexyvotes
DB_CONN_MAX_AGE=600
DB_STATEMENT_TIMEOUT_MS=30000
DB_DISABLE_SERVER_SIDE_CURSORS=False
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/1
QUEUE_BACKPRESSURE_THRESHOLD=50000

# --- Security ------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
TRUSTED_PROXY_COUNT=1
SESSION_COOKIE_AGE=28800
ENFORCE_STAFF_MFA=True
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
# Voter limits per client IP (a campus NAT can put hundreds of voters on one IP;
# per-voter limits stay strict regardless). Also see deploy/nginx/trusted_nat.conf.
VOTER_LOGIN_PER_IP_PER_MIN=120
VOTER_OTP_PER_IP_PER_5MIN=100
VOTER_REGISTER_PER_IP_PER_10MIN=30
CSP_REPORT_ONLY=False
API_CORS_ALLOWED_ORIGINS=
# Bot protection: turnstile | hcaptcha | recaptcha | (empty = honeypot only)
CAPTCHA_PROVIDER=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
WEBAUTHN_RP_ID=vote.example.com
WEBAUTHN_ORIGIN=https://vote.example.com

# --- Keys (generate with: python manage.py keys generate-kek | generate-signing-key | generate-blind-index)
FIELD_ENCRYPTION_KEYS=
# KMS_KEY_ID=arn:aws:kms:eu-north-1:123456789012:key/...
AWS_REGION=eu-north-1
SIGNING_PRIVATE_KEY=
SIGNING_PREVIOUS_PUBLIC_KEYS=
BLIND_INDEX_KEY=

# --- Payments (Paystack) ------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYMENT_ABANDON_AFTER_MINUTES=30
REFUND_DUAL_APPROVAL_THRESHOLD=500
# Development only - refused when DEBUG=False:
PAYMENTS_FAKE_GATEWAY=False

# --- SMS / USSD (Africa's Talking) and WhatsApp --------------------------------
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
USSD_CALLBACK_TOKEN=
USSD_ALLOWED_IPS=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Email -----------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.com
# Monitored inbox published in /.well-known/security.txt
SECURITY_CONTACT=security@example.com

# --- Single sign-on (OIDC) ------------------------------------------------------
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
MICROSOFT_OIDC_TENANT=common
MICROSOFT_OIDC_CLIENT_ID=
MICROSOFT_OIDC_CLIENT_SECRET=

# --- Media ---------------------------------------------------------------------
MEDIA_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PRIVATE_MEDIA_ROOT=/app/private_media

# --- Fraud thresholds (0-100) ------------------------------------------------------
FRAUD_MONITOR_THRESHOLD=31
FRAUD_CHALLENGE_THRESHOLD=61
FRAUD_HOLD_THRESHOLD=81
FRAUD_FLAG_PROXIES=True

# --- Billing ---------------------------------------------------------------------
BILLING_VAT_RATE=15.0
BILLING_LEVY_RATE=6.0
BILLING_TRIAL_DAYS=14

# --- Observability ---------------------------------------------------------------
LOG_FORMAT=json
DJANGO_LOG_LEVEL=INFO
METRICS_TOKEN=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
APP_VERSION=

# --- First admin (created/synced on container start) -----------------------------
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Backups (the `backup` service; see docs/DISASTER_RECOVERY.md) -----------------
# Encrypts every backup (AES-256). REQUIRED for backups to run; at least 16
# characters. Keep a copy offline - without it no backup can be restored.
# Use single quotes if it contains a $ sign.
BACKUP_PASSPHRASE=
# Cron schedule in TIME_ZONE (default: every night at 02:00).
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=14
# Push every backup to the application's GitHub repository, on its own orphan
# branch (BACKUP_GIT_BRANCH, never main). The repository MUST be private - pushes
# to a public repository are refused. Token: fine-grained, limited to this
# repository, "Contents: Read and write" (protect `main` with a ruleset).
BACKUP_GIT_REPO=https://github.com/deOpty/flexyvotes.git
BACKUP_GIT_TOKEN=
BACKUP_GIT_BRANCH=backups
BACKUP_GIT_RETENTION_DAYS=30
# false (default) = the backups branch is one snapshot commit of the kept sets,
# so clones of the repository stay small. true = keep every backup in history.
BACKUP_GIT_KEEP_HISTORY=false
# Restore the newest backup automatically when the database is empty (new server).
BACKUP_RESTORE_ON_SETUP=true

# --- pgAdmin (starts with the stack; server "FlexyVotes" is pre-registered) --------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=
# Host port; pick another (e.g. 5051) if a different pgAdmin already uses 5050.
PGADMIN_PORT=5051
# Interface to publish on. Keep 127.0.0.1 on servers and use an SSH/SSM tunnel.
PGADMIN_BIND=127.0.0.1
