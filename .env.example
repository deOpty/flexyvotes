SECRET_KEY=change-me-to-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://your-domain.example.com
SITE_URL=https://your-domain.example.com

# Port the app listens on (gunicorn/Docker). Change this if 8000 is already
# taken by another service on your machine. docker-compose maps the same
# value on the host side, so changing it here is enough.
PORT=8000

DATABASE_URL=postgres://user:password@host:5432/dbname
# Set to False only for local Postgres containers without SSL configured (e.g. docker-compose)
DATABASE_SSL_REQUIRE=True

# Set True once TLS termination (ALB/CloudFront) is confirmed in front of the app
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

PAYSTACK_SECRET_KEY=sk_live_or_test_key_here

AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key_here

EMAIL_HOST_USER=your_gmail_address@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password_here

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: if both username and password are set, the Docker entrypoint
# will automatically create this Django superuser on container start
# (skipped if a user with this username already exists). Leave unset to
# create your admin account manually via `manage.py createsuperuser` instead.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-strong-password
